% ============================================================
% FEASIBILITY METRIC JUSTIFICATION
% ============================================================

% Closest precedent for our binary feasibility metric.
% Reports "percentage of scenarios satisfying constraints" at four binary thresholds:
% 0.01, 1e-4, 1e-6, 1e-8 absolute violation — 0.01 matches our _FEAS_THRESH exactly.
% Same Google DeepMind group as OPFData. Also a direct baseline/related work for case118.
@article{piloto2024canos,
  title   = {{CANOS}: A Fast and Scalable Neural {AC-OPF} Solver Robust To {N-1} Perturbations},
  author  = {Piloto, Luis and Liguori, Sofia and Madjiheurem, Sephora and Zgubi{\v{c}}, Miha
             and Lovett, Sean and Tomlinson, Hamish and Elster, Sophie and Apps, Chris
             and Witherspoon, Sims},
  journal = {arXiv preprint arXiv:2403.17660},
  year    = {2024},
  note    = {arXiv:2403.17660}
}

% Standard reference for Newton-Raphson power flow convergence tolerance (pf.tol = 1e-8 pu).
% Our 0.01 pu threshold is a relaxed NR criterion appropriate for ML-based approximations.
% Cite when justifying the 0.01 pu threshold as physically grounded.
@article{zimmerman2011matpower,
  author  = {Zimmerman, R. D. and Murillo-S{\'a}nchez, C. E. and Thomas, R. J.},
  title   = {{MATPOWER}: Steady-State Operations, Planning, and Analysis Tools for Power Systems Research and Education},
  journal = {{IEEE} Transactions on Power Systems},
  volume  = {26},
  number  = {1},
  pages   = {12--19},
  year    = {2011},
  doi     = {10.1109/TPWRS.2010.2051168}
}

% Only paper found that explicitly connects the ML-OPF evaluation tolerance to NR convergence.
% Trains at epsilon=1e-9, tests at epsilon=1e-4, and notes the tolerance choice affects
% reported feasibility. Supports the argument that evaluation threshold selection is principled.
@inproceedings{baker2020learningboosted,
  author    = {Baker, Kyri},
  title     = {A Learning-boosted Quasi-{N}ewton Method for {AC} Optimal Power Flow},
  booktitle = {NeurIPS 2020 Workshop on Machine Learning for Engineering Modeling, Simulation and Design},
  year      = {2020},
  note      = {arXiv:2007.06074}
}

